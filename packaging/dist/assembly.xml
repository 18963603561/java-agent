<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 https://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <id>linux-x64</id>
  <formats>
    <format>tar.gz</format>
  </formats>
  <baseDirectory>java-agent</baseDirectory>
  <files>
    <file>
      <source>${project.build.directory}/${project.build.finalName}.jar</source>
      <outputDirectory>lib</outputDirectory>
      <destName>java-agent.jar</destName>
      <fileMode>644</fileMode>
    </file>
    <file>
      <source>${project.basedir}/packaging/dist/bin/java-agent</source>
      <outputDirectory>bin</outputDirectory>
      <destName>java-agent</destName>
      <fileMode>755</fileMode>
    </file>
    <file>
      <source>${project.basedir}/packaging/dist/bin/java-agent-env.sh</source>
      <outputDirectory>bin</outputDirectory>
      <destName>java-agent-env.sh</destName>
      <fileMode>755</fileMode>
    </file>
    <file>
      <source>${project.basedir}/packaging/dist/bin/java-agent.cmd</source>
      <outputDirectory>bin</outputDirectory>
      <destName>java-agent.cmd</destName>
      <fileMode>644</fileMode>
    </file>
    <file>
      <source>${project.basedir}/packaging/dist/conf/java-agent.conf</source>
      <outputDirectory>conf</outputDirectory>
      <destName>java-agent.conf</destName>
      <fileMode>644</fileMode>
    </file>
    <file>
      <source>${project.basedir}/README.md</source>
      <outputDirectory>.</outputDirectory>
      <destName>README.md</destName>
      <fileMode>644</fileMode>
    </file>
  </files>
  <fileSets>
    <fileSet>
      <directory>${project.basedir}/src/main/resources</directory>
      <outputDirectory>conf</outputDirectory>
      <directoryMode>755</directoryMode>
      <fileMode>644</fileMode>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/doc/ops</directory>
      <outputDirectory>doc/ops</outputDirectory>
      <directoryMode>755</directoryMode>
      <fileMode>644</fileMode>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/packaging/dist/logs</directory>
      <outputDirectory>logs</outputDirectory>
      <directoryMode>755</directoryMode>
      <fileMode>644</fileMode>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/packaging/dist/run</directory>
      <outputDirectory>run</outputDirectory>
      <directoryMode>755</directoryMode>
      <fileMode>644</fileMode>
    </fileSet>
  </fileSets>
</assembly>
